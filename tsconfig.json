{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "types": ["node"],
    "moduleResolution": "node",
    "rootDir": ".",
    "target": "esnext",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "skipLibCheck": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"]
    },
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "*.ts",
    "src/**/*",
    "test/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
